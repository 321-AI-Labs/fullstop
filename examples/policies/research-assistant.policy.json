{
  "write_preapproved": [
    "notes/**",
    "draft.md",
    "memory.md"
  ],
  "protected_paths": [
    ".env",
    "*.pem",
    "secrets/**"
  ],
  "shell": {
    "allow": [
      {
        "program": "git",
        "args": [
          "status"
        ]
      },
      {
        "program": "git",
        "args": [
          "log",
          "--oneline",
          "*"
        ]
      }
    ],
    "deny": [
      "rm"
    ]
  },
  "web": {
    "allow_domains": [
      "en.wikipedia.org",
      "arxiv.org",
      "pypi.org"
    ]
  }
}
